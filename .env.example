# Injenium (灵枢) — example environment. Copy to `.env` and fill in.
# `.env` is gitignored; NEVER commit real keys or salts.

# ── Wallet identity (read from the environment by the agent) ────────────────
# Fixed per-robot IP injected at agent boot; the agent derives a deterministic
# testnet wallet from it (key = sha256(WALLET_SALT || ROBOT_IP)).
ROBOT_IP=10.88.15.25
# Deployment secret mixed into the derivation so the key can't be rebuilt from
# the LAN-visible IP alone. Use a strong, per-fleet value.
WALLET_SALT=change-me
# Explicit signing key. Overrides ROBOT_IP derivation and is REQUIRED on mainnet
# (IP derivation is refused there). Also used by contracts/script/deploy.sh.
# INJECTIVE_PRIVATE_KEY=0xYOUR_TESTNET_KEY

# ── Off-chain recipe storage (IPFS_API_URL read from the environment) ───────
# The requester resolves ipfs:// recipe pointers through this Kubo HTTP API.
IPFS_API_URL=http://127.0.0.1:5001

# ── Chain / config reference (passed to `dimos run` as module flags, not env) ─
# testnet chain id 1439 / mainnet 1776. After deploy.sh, pass matching
# blueprint long options to BOTH chain-using modules:
#   --marketskillcontainer.chain-backend injective
#   --marketskillcontainer.market-contract <ADDRESS>
#   --marketskillcontainer.chain-id 1439
#   --marketskillcontainer.rpc-url https://k8s.testnet.json-rpc.injective.network/
#   --marketskillcontainer.recipe-storage ipfs
#   --requestlistener.chain-backend injective
#   --requestlistener.market-contract <ADDRESS>
#   --requestlistener.chain-id 1439
#   --requestlistener.rpc-url https://k8s.testnet.json-rpc.injective.network/
# CHAIN_ID=1439
# INJECTIVE_RPC_URL=https://k8s.testnet.json-rpc.injective.network/
# MARKET_CONTRACT=0xDEPLOYED_ADDRESS
